# 서버 환경변수 안내 파일 (이 파일은 프로그램이 읽지 않아요)
# 사용법: 이 파일을 복사해 같은 폴더에 .env 파일을 만들고, 빈 칸(= 뒤)에 실제 값을 넣어요.
#   cp .env.example .env
# ※ 실제 값은 .env 에만 넣어요. .env 는 git 에 올라가지 않아요.

# 서버 실행 환경 (development | production)
NODE_ENV=development

# 서버 포트
PORT=4000

# MongoDB 접속 주소 (로컬 MongoDB 기준, Atlas 를 쓰면 mongodb+srv://... 주소로 바꿔요)
MONGODB_URI=mongodb://127.0.0.1:27017/hw-mall

# CORS 허용 출처 (프론트엔드 주소, 여러 개면 쉼표로 구분)
CLIENT_ORIGIN=http://localhost:5173

# [필수] JWT 토큰 서명용 비밀키 - 아래 명령으로 만든 긴 무작위 문자열을 넣어요.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# 토큰 유효 기간 (예: 1h, 1d, 7d)
JWT_EXPIRES_IN=1d

# Cloudinary 클라우드 이름 (상품 실물 사진 주소 확인용)
# - Cloudinary 콘솔 → 설정(톱니바퀴) → API Keys 화면 맨 위의 "Cloud name"
# - client/.env 의 VITE_CLOUDINARY_CLOUD_NAME 과 같은 값
CLOUDINARY_CLOUD_NAME=

# [주문 결제] 토스페이먼츠 시크릿 키 (서버에만 두는 비밀값)
# - 토스페이먼츠 개발자센터 → API 키 → 테스트 시크릿 키 (test_sk_ 로 시작)
# - client/.env 의 VITE_TOSS_CLIENT_KEY(테스트 클라이언트 키)와 같은 상점의 키여야 해요
TOSS_SECRET_KEY=
