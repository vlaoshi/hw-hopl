# 서버 실행 환경 (development | production)
NODE_ENV=development
# 서버 포트
PORT=4000
# MongoDB 접속 주소 (로컬 MongoDB 기준, Atlas 사용 시 mongodb+srv://... 주소로 교체)
MONGODB_URI=mongodb://127.0.0.1:27017/hw-mall
# CORS 허용 출처 (프론트엔드 주소, 여러 개면 쉼표로 구분)
CLIENT_ORIGIN=http://localhost:5173
# JWT 토큰 서명용 비밀키 (아래 명령으로 만든 긴 무작위 문자열을 넣으세요)
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=여기에_긴_무작위_문자열을_넣으세요
# 토큰 유효 기간 (예: 1h, 1d, 7d)
JWT_EXPIRES_IN=1d
