# 프론트엔드 환경변수 안내 파일 (이 파일은 프로그램이 읽지 않아요)
# 사용법: 이 파일을 복사해 같은 폴더에 .env 파일을 만들고, 빈 칸(= 뒤)에 실제 값을 넣어요.
#   cp .env.example .env
# ※ VITE_ 로 시작하는 값은 브라우저에 그대로 드러나요. API Secret 같은 비밀값은 절대 넣지 마세요.

# Cloudinary 클라우드 이름 (상품 실물 사진 업로드 위젯)
# - Cloudinary 콘솔 → 설정(톱니바퀴) → API Keys 화면 맨 위의 "Cloud name"
# - server/.env 의 CLOUDINARY_CLOUD_NAME 과 같은 값
VITE_CLOUDINARY_CLOUD_NAME=

# Cloudinary 업로드 프리셋 이름
# - Settings → Upload → Upload presets 에서 Signing mode 를 "Unsigned" 로 만든 프리셋
VITE_CLOUDINARY_UPLOAD_PRESET=

# [주문 결제] 포트원 V2 상점 아이디 (store- 로 시작)
# - 포트원 관리자 콘솔 → 결제 연동 → 연동 정보 → 식별코드·API Keys → V2 API 탭의 Store ID
VITE_PORTONE_STORE_ID=

# [주문 결제] 포트원 채널 키 (channel-key- 로 시작) - KG이니시스 테스트 채널
# - 포트원 관리자 콘솔 → 결제 연동 → 연동 정보 → 채널 관리 → 채널 추가(환경: 테스트, 결제대행사: KG이니시스)
# ※ API Secret 은 여기가 아니라 server/.env 의 PORTONE_API_SECRET 에 넣어요.
VITE_PORTONE_CHANNEL_KEY=
